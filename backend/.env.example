PORT=5000
NODE_ENV=development

# PostgreSQL DB Configuration


DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=arham_db
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# BSE Simulator Settings
MOCK_BSE_URL=http://localhost:5000/api/bse
MOCK_BSE_DELAY_MS=500
MOCK_BSE_FAILURE_RATE=0.20

